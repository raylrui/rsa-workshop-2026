<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Research Cloud Cost Intelligence — {{ kpis.run_at[:10] }}</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f8fafc;
      color: #1e2a3a;
      font-size: 14px;
      line-height: 1.5;
    }

    /* ── Header ── */
    header {
      background: #1e2a3a;
      color: #fff;
      padding: 20px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .header-left h1 {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: #f8fafc;
    }
    .header-left p {
      font-size: 0.78rem;
      color: #94a3b8;
      margin-top: 2px;
    }
    .header-meta {
      font-size: 0.75rem;
      color: #64748b;
      text-align: right;
    }
    .demo-badge {
      display: inline-block;
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fcd34d;
      border-radius: 5px;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 2px 7px;
      text-transform: uppercase;
      margin-left: 8px;
      vertical-align: middle;
    }

    /* ── KPI bar ── */
    #kpi-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      padding: 18px 32px;
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
    }
    .kpi-card {
      flex: 1 1 150px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 14px 18px;
    }
    .kpi-label {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: #64748b;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .kpi-value {
      font-size: 1.55rem;
      font-weight: 700;
      color: #1e2a3a;
      line-height: 1.15;
    }
    .kpi-sub {
      font-size: 0.68rem;
      color: #94a3b8;
      margin-top: 2px;
    }
    .kpi-critical .kpi-value { color: #c0392b; }
    .kpi-high     .kpi-value { color: #d35400; }
    .kpi-blue     .kpi-value { color: #2563eb; }

    /* ── Main layout ── */
    main {
      max-width: 1360px;
      margin: 0 auto;
      padding: 24px 32px;
    }
    section { margin-bottom: 32px; }

    .section-heading {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid #e2e8f0;
    }

    /* ── Charts grid ── */
    .charts-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
    }
    @media (max-width: 860px) {
      .charts-grid { grid-template-columns: 1fr; }
    }
    .charts-grid-bottom {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    .chart-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 18px 20px;
    }
    .chart-card h3 {
      font-size: 0.78rem;
      font-weight: 600;
      color: #475569;
      margin-bottom: 14px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .chart-canvas-wrapper { position: relative; }
    .chart-canvas-wrapper.tall { height: 320px; }
    .chart-canvas-wrapper.short { height: 240px; }

    /* ── Findings table ── */
    #findings-table-wrapper {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      overflow: hidden;
    }
    .table-toolbar {
      padding: 10px 14px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }
    .table-toolbar label {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .table-toolbar select,
    .table-toolbar input[type="text"] {
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 4px 8px;
      font-size: 0.78rem;
      color: #1e2a3a;
      background: #fff;
    }
    .table-toolbar select:focus,
    .table-toolbar input:focus {
      outline: none;
      border-color: #2563eb;
    }

    #findings-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }
    #findings-table thead { background: #f1f5f9; }
    #findings-table th {
      padding: 9px 12px;
      text-align: left;
      font-size: 0.7rem;
      font-weight: 700;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      white-space: nowrap;
      user-select: none;
      border-bottom: 1px solid #e2e8f0;
    }
    #findings-table th:hover { background: #e2e8f0; }
    #findings-table td {
      padding: 9px 12px;
      border-top: 1px solid #f1f5f9;
      vertical-align: top;
    }
    #findings-table tbody tr:hover { background: #f8fafc; }

    /* ── Badges ── */
    .badge {
      display: inline-block;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 10px;
      letter-spacing: 0.04em;
      color: #fff;
      white-space: nowrap;
    }
    .badge-CRITICAL { background: #c0392b; }
    .badge-HIGH     { background: #d35400; }
    .badge-MEDIUM   { background: #b7860f; }
    .badge-LOW      { background: #27ae60; }
    .badge-ANOMALY  { background: #5b4fcf; }
    .badge-IDLE     { background: #1a56a0; }
    .badge-TAGGING  { background: #0e7c6a; }
    .badge-BUDGET   { background: #a93226; }

    /* ── Detail panel ── */
    .detail-btn {
      cursor: pointer;
      color: #2563eb;
      font-size: 0.72rem;
      border: none;
      background: none;
      padding: 0;
      text-decoration: underline;
      text-decoration-color: #bfdbfe;
    }
    .detail-row { display: none; }
    .detail-row.open { display: table-row; }
    .detail-content {
      padding: 10px 14px 14px 28px;
      font-size: 0.78rem;
      color: #475569;
      background: #f8fafc;
      border-top: 1px dashed #e2e8f0;
      line-height: 1.65;
    }

    /* ── AI narrative ── */
    #bedrock-section {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 10px;
      padding: 20px 24px;
    }
    .ai-label {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #3b82f6;
      margin-bottom: 10px;
    }
    #bedrock-narrative {
      font-size: 0.875rem;
      color: #1e3a5f;
      white-space: pre-wrap;
      line-height: 1.75;
    }

    /* ── Footer ── */
    footer {
      text-align: center;
      font-size: 0.72rem;
      color: #94a3b8;
      padding: 20px;
      border-top: 1px solid #e2e8f0;
      margin-top: 12px;
    }
  </style>
</head>
<body>

<!-- ── Header ── -->
<header>
  <div class="header-left">
    <h1>Research Cloud Cost Intelligence
      {% if kpis.mode == "demo" %}<span class="demo-badge">Demo Data</span>{% endif %}
    </h1>
    <p>Cost anomaly, waste and budget risk detection for research workloads</p>
  </div>
  <div class="header-meta">
    Generated {{ kpis.run_at[:19] }} UTC<br>
    Mode: {{ kpis.mode | upper }}
  </div>
</header>

<!-- ── KPI bar ── -->
<div id="kpi-bar">
  <div class="kpi-card">
    <div class="kpi-label">Total Spend</div>
    <div class="kpi-value">${{ "{:,.0f}".format(kpis.total_spend_usd) }}</div>
    <div class="kpi-sub">90-day period</div>
  </div>
  <div class="kpi-card kpi-blue">
    <div class="kpi-label">Estimated Waste</div>
    <div class="kpi-value">${{ "{:,.0f}".format(kpis.total_estimated_waste_usd) }}</div>
    {% if kpis.total_spend_usd %}
    <div class="kpi-sub">{{ "%.2f"|format(kpis.total_estimated_waste_usd / kpis.total_spend_usd * 100) }}% of total spend</div>
    {% endif %}
  </div>
  <div class="kpi-card {{ 'kpi-critical' if kpis.critical_count else '' }}">
    <div class="kpi-label">Cost Anomalies</div>
    <div class="kpi-value">{{ kpis.anomaly_count }}</div>
    <div class="kpi-sub">{{ kpis.critical_count }} critical</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Idle Resources</div>
    <div class="kpi-value">{{ kpis.idle_count }}</div>
    <div class="kpi-sub">CPU or GPU underutilised</div>
  </div>
  <div class="kpi-card {{ 'kpi-high' if kpis.budget_count else '' }}">
    <div class="kpi-label">Budget Risks</div>
    <div class="kpi-value">{{ kpis.budget_count }}</div>
    <div class="kpi-sub">{{ kpis.tagging_count }} tag issues</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Total Findings</div>
    <div class="kpi-value">{{ kpis.finding_count }}</div>
    <div class="kpi-sub">{{ kpis.critical_count }} critical · {{ kpis.high_count }} high</div>
  </div>
</div>

<main>

<!-- ── Charts ── -->
<section>
  <div class="section-heading">Spend &amp; Waste Analysis</div>
  <div class="charts-grid">
    <div class="chart-card">
      <h3>Daily Cloud Spend — Last 30 Days</h3>
      <div class="chart-canvas-wrapper tall">
        <canvas id="chartDailyCost"></canvas>
      </div>
    </div>
    <div class="chart-card">
      <h3>Estimated Waste by Category</h3>
      <div class="chart-canvas-wrapper tall">
        <canvas id="chartWaste"></canvas>
      </div>
    </div>
  </div>
  <div class="charts-grid-bottom">
    <div class="chart-card">
      <h3>Findings by Severity</h3>
      <div class="chart-canvas-wrapper short">
        <canvas id="chartSeverity"></canvas>
      </div>
    </div>
    <div class="chart-card">
      <h3>Findings by Category</h3>
      <div class="chart-canvas-wrapper short">
        <canvas id="chartCategory"></canvas>
      </div>
    </div>
  </div>
</section>

<!-- ── Findings table ── -->
<section>
  <div class="section-heading">Findings</div>
  <div id="findings-table-wrapper">
    <div class="table-toolbar">
      <label>Severity</label>
      <select id="filterSev" onchange="filterTable()">
        <option value="">All</option>
        <option value="CRITICAL">Critical</option>
        <option value="HIGH">High</option>
        <option value="MEDIUM">Medium</option>
        <option value="LOW">Low</option>
      </select>
      <label>Category</label>
      <select id="filterCat" onchange="filterTable()">
        <option value="">All</option>
        <option value="ANOMALY">Anomaly</option>
        <option value="IDLE">Idle</option>
        <option value="TAGGING">Tagging</option>
        <option value="BUDGET">Budget</option>
      </select>
      <label>Search</label>
      <input type="text" id="searchInput" placeholder="Project, resource or title…" oninput="filterTable()" style="width:200px" />
    </div>
    <table id="findings-table">
      <thead>
        <tr>
          <th onclick="sortTable(0)">Severity</th>
          <th onclick="sortTable(1)">Category</th>
          <th onclick="sortTable(2)">Project</th>
          <th onclick="sortTable(3)">Resource</th>
          <th onclick="sortTable(4)">Finding</th>
          <th onclick="sortTable(5)">Waste (USD)</th>
          <th>Detail</th>
        </tr>
      </thead>
      <tbody id="findings-tbody">
        {% for f in findings %}
        <tr class="finding-row"
            data-sev="{{ f.severity }}"
            data-cat="{{ f.category }}"
            data-text="{{ (f.project_id ~ ' ' ~ f.title ~ ' ' ~ (f.resource_id or '')) | lower }}">
          <td><span class="badge badge-{{ f.severity }}">{{ f.severity }}</span></td>
          <td><span class="badge badge-{{ f.category }}">{{ f.category }}</span></td>
          <td>{{ f.project_id }}</td>
          <td style="font-size:0.75rem;color:#64748b">{{ f.resource_id or "—" }}</td>
          <td style="max-width:340px">{{ f.title }}</td>
          <td style="white-space:nowrap">${{ "{:,.2f}".format(f.estimated_waste_usd) }}</td>
          <td>
            <button class="detail-btn" onclick="toggleDetail('d{{ loop.index }}')">show</button>
          </td>
        </tr>
        <tr id="d{{ loop.index }}" class="detail-row">
          <td colspan="7">
            <div class="detail-content">{{ f.detail }}</div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

{% if bedrock_narrative %}
<!-- ── AI narrative ── -->
<section id="bedrock-section">
  <div class="ai-label">AI Research IT Summary &nbsp;·&nbsp; Amazon Bedrock — AI-generated analysis, not independently verified</div>
  <div id="bedrock-narrative">{{ bedrock_narrative }}</div>
</section>
{% endif %}

</main>

<footer>
  Research Cloud Cost Intelligence &nbsp;·&nbsp; Generated {{ kpis.run_at[:19] }} UTC
  {% if kpis.mode == "demo" %}&nbsp;·&nbsp; <strong>Synthetic demo data — not real AWS billing data</strong>{% endif %}
</footer>

<!-- ── Chart.js ── -->
<script>
const D = {{ chart_data_json }};

const SEV_COLOURS = {
  CRITICAL: "#c0392b", HIGH: "#d35400", MEDIUM: "#b7860f", LOW: "#27ae60"
};
const CAT_COLOURS = {
  ANOMALY: "#5b4fcf", IDLE: "#1a56a0", TAGGING: "#0e7c6a", BUDGET: "#a93226"
};
const PROJECT_PALETTE = [
  "#2563eb","#d97706","#059669","#dc2626","#7c3aed",
  "#0891b2","#ea580c","#16a34a","#9333ea","#0284c7"
];

const baseChartOpts = {
  responsive: true,
  maintainAspectRatio: false,
  plugins: { legend: { labels: { font: { size: 11 }, boxWidth: 10 } } },
};

// 1. Daily cost
new Chart(document.getElementById("chartDailyCost"), {
  type: "line",
  data: {
    labels: D.daily_dates,
    datasets: D.daily_projects.map((p, i) => ({
      label: p.replace("proj-", ""),
      data: D.daily_costs_by_project[p],
      borderColor: PROJECT_PALETTE[i % PROJECT_PALETTE.length],
      backgroundColor: "transparent",
      borderWidth: 1.8,
      pointRadius: 1.5,
      tension: 0.25,
    }))
  },
  options: {
    ...baseChartOpts,
    plugins: {
      legend: { position: "bottom", labels: { font: { size: 10 }, boxWidth: 10, padding: 10 } }
    },
    scales: {
      x: { grid: { color: "#f1f5f9" }, ticks: { maxTicksLimit: 10, font: { size: 10 } } },
      y: {
        grid: { color: "#f1f5f9" },
        ticks: { callback: v => "$" + v.toLocaleString(), font: { size: 10 } }
      },
    },
  }
});

// 2. Waste bar
{
  const cats = Object.keys(D.waste_by_category);
  new Chart(document.getElementById("chartWaste"), {
    type: "bar",
    data: {
      labels: cats,
      datasets: [{ data: cats.map(c => D.waste_by_category[c]),
        backgroundColor: cats.map(c => CAT_COLOURS[c] || "#94a3b8") }]
    },
    options: {
      ...baseChartOpts,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: "#f1f5f9" }, ticks: { font: { size: 11 } } },
        y: { grid: { color: "#f1f5f9" },
             ticks: { callback: v => "$" + v.toLocaleString(), font: { size: 10 } } },
      },
    }
  });
}

// 3. Severity doughnut
{
  const sevs = Object.keys(D.severity_counts);
  new Chart(document.getElementById("chartSeverity"), {
    type: "doughnut",
    data: {
      labels: sevs,
      datasets: [{ data: sevs.map(s => D.severity_counts[s]),
        backgroundColor: sevs.map(s => SEV_COLOURS[s] || "#999"),
        borderWidth: 2, borderColor: "#f8fafc" }]
    },
    options: {
      ...baseChartOpts,
      plugins: { legend: { position: "bottom", labels: { font: { size: 11 }, boxWidth: 12 } } },
      cutout: "55%",
    }
  });
}

// 4. Category bar
{
  const cats = Object.keys(D.category_counts);
  new Chart(document.getElementById("chartCategory"), {
    type: "bar",
    data: {
      labels: cats,
      datasets: [{ data: cats.map(c => D.category_counts[c]),
        backgroundColor: cats.map(c => CAT_COLOURS[c] || "#94a3b8") }]
    },
    options: {
      ...baseChartOpts,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: "#f1f5f9" }, ticks: { font: { size: 11 } } },
        y: { grid: { color: "#f1f5f9" }, ticks: { stepSize: 1, font: { size: 10 } } },
      },
    }
  });
}

// Table sort
let _col = -1, _asc = true;
function sortTable(col) {
  const tbody = document.getElementById("findings-tbody");
  const rows  = [...tbody.querySelectorAll("tr.finding-row")];
  _asc  = _col === col ? !_asc : true;
  _col  = col;
  rows.sort((a, b) => {
    const ta = a.cells[col]?.innerText.trim() || "";
    const tb = b.cells[col]?.innerText.trim() || "";
    const na = parseFloat(ta.replace(/[$,]/g, ""));
    const nb = parseFloat(tb.replace(/[$,]/g, ""));
    const c  = !isNaN(na) && !isNaN(nb) ? na - nb : ta.localeCompare(tb);
    return _asc ? c : -c;
  });
  rows.forEach(row => {
    const id = row.querySelector(".detail-btn")?.getAttribute("onclick")?.match(/'([^']+)'/)?.[1];
    tbody.appendChild(row);
    if (id) { const d = document.getElementById(id); if (d) tbody.appendChild(d); }
  });
}

// Table filter
function filterTable() {
  const sev = document.getElementById("filterSev").value;
  const cat = document.getElementById("filterCat").value;
  const q   = document.getElementById("searchInput").value.toLowerCase();
  document.querySelectorAll("tr.finding-row").forEach(row => {
    const ok = (!sev || row.dataset.sev === sev) &&
               (!cat || row.dataset.cat === cat) &&
               (!q   || row.dataset.text.includes(q));
    row.style.display = ok ? "" : "none";
    const id = row.querySelector(".detail-btn")?.getAttribute("onclick")?.match(/'([^']+)'/)?.[1];
    if (id) { const d = document.getElementById(id); if (d && !ok) d.style.display = "none"; }
  });
}

// Detail toggle
function toggleDetail(id) {
  const row = document.getElementById(id);
  if (!row) return;
  row.classList.toggle("open");
  const btn = row.previousElementSibling?.querySelector(".detail-btn");
  if (btn) btn.textContent = row.classList.contains("open") ? "hide" : "show";
}
</script>

</body>
</html>
